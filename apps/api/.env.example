NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://atyantik:change_me_in_prod@localhost:5432/atyantik_ems?schema=public"

# Generate real values with: openssl rand -hex 32
# Each of these four must be a distinct value — JWT_ACCESS_SECRET and
# JWT_REFRESH_SECRET are enforced distinct at startup (see src/config/env.ts).
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string_from_openssl_rand
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

COOKIE_SECRET=replace_with_another_random_64_char_hex_string_value
CSRF_SECRET=replace_with_yet_another_random_64_char_hex_string_value

WEB_APP_URL=http://localhost:3000

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Atyantik EMS <no-reply@atyantik.com>"

SUPER_ADMIN_EMAIL=kalpeshpatel@atyantik.com
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMe@12345
