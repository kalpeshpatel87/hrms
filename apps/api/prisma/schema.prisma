  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   User      @relation(fields: [interviewerId], references: [id])
  feedback      String?
  rating        Decimal?  @db.Decimal(3, 2)
  submittedAt   DateTime?

  @@unique([interviewId, interviewerId])
  @@map("interview_panelists")
}

model Offer {
  id            String       @id @default(cuid())
  candidateId   String       @unique
  candidate     Candidate    @relation(fields: [candidateId], references: [id])
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])
  ctcAnnual     Decimal      @db.Decimal(14, 2)
  joiningDate   DateTime     @db.Date
  status        OfferStatus  @default(DRAFT)
  sentAt        DateTime?
  respondedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("offers")
}

// =========================================================================
// ONBOARDING
// =========================================================================

model OnboardingChecklist {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  employee     Employee  @relation(fields: [employeeId], references: [id])
  templateName String    @default("Default")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  tasks OnboardingTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("onboarding_checklists")
}

model OnboardingTask {
  id                    String               @id @default(cuid())
  onboardingChecklistId String
  onboardingChecklist   OnboardingChecklist  @relation(fields: [onboardingChecklistId], references: [id], onDelete: Cascade)
  taskName              String
  assignedToId          String?
  assignedTo            User?                @relation(fields: [assignedToId], references: [id])
  status                OnboardingTaskStatus @default(PENDING)
  dueDate               DateTime?            @db.Date
  completedAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([onboardingChecklistId])
  @@map("onboarding_tasks")
}

// =========================================================================
// HELPDESK
// =========================================================================

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  raisedById   String
  raisedBy     Employee       @relation(fields: [raisedById], references: [id])
  category     TicketCategory @default(IT)
  priority     TicketPriority @default(MEDIUM)
  subject      String
  description  String?
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  assignedTo   User?          @relation(fields: [assignedToId], references: [id])
  resolvedAt   DateTime?

  comments TicketComment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([status, priority])
  @@index([raisedById])
  @@map("tickets")
}

model TicketComment {
  id            String  @id @default(cuid())
  ticketId      String
  ticket        Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User    @relation(fields: [authorId], references: [id])
  body          String
  attachmentUrl String?
  isInternal    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([ticketId])
  @@map("ticket_comments")
}

// =========================================================================
// LEARNING MANAGEMENT
// =========================================================================

model Course {
  id              String  @id @default(cuid())
  companyId       String
  company         Company @relation(fields: [companyId], references: [id])
  title           String
  description     String?
  durationMinutes Int?
  provider        String?
  isMandatory     Boolean @default(false)

  enrollments Enrollment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("courses")
}

model Enrollment {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id])
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  status      EnrollmentStatus @default(NOT_STARTED)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  score       Decimal?         @db.Decimal(5, 2)

  assessments Assessment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([courseId, employeeId])
  @@map("enrollments")
}

model Assessment {
  id            String     @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title         String
  maxScore      Decimal    @db.Decimal(5, 2)
  obtainedScore Decimal?   @db.Decimal(5, 2)
  attemptedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([enrollmentId])
  @@map("assessments")
}

// =========================================================================
// EXPENSE MANAGEMENT
// =========================================================================

model ExpenseClaim {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  title        String
  totalAmount  Decimal       @db.Decimal(12, 2)
  currency     String        @default("INR")
  status       ExpenseStatus @default(DRAFT)
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  payrollRunId String?
  payrollRun   PayrollRun?   @relation(fields: [payrollRunId], references: [id])

  items ExpenseItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId, status])
  @@map("expense_claims")
}

model ExpenseItem {
  id             String          @id @default(cuid())
  expenseClaimId String
  expenseClaim   ExpenseClaim    @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime        @db.Date
  receiptUrl     String?
  description    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([expenseClaimId])
  @@map("expense_items")
}

// =========================================================================
// TRAVEL MANAGEMENT
// =========================================================================

model TravelRequest {
  id            String       @id @default(cuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  purpose       String
  origin        String
  destination   String
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  estimatedCost Decimal?     @db.Decimal(12, 2)
  status        TravelStatus @default(PENDING)
  approvedById  String?
  approvedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId, status])
  @@map("travel_requests")
}

// =========================================================================
// DOCUMENTS (generic vault, versioned)
// =========================================================================

model Document {
  id               String           @id @default(cuid())
  title            String
  category         DocumentCategory @default(OTHER)
  ownerEmployeeId  String?
  ownerEmployee    Employee?        @relation(fields: [ownerEmployeeId], references: [id])
  entityType       String?
  entityId         String?
  isConfidential   Boolean          @default(false)
  currentVersionId String?          @unique
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions DocumentVersion[] @relation("DocumentVersions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([entityType, entityId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNo    Int
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  checksum     String?
  uploadedById String?

  currentFor Document? @relation("CurrentVersion")

  createdAt DateTime @default(now())

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

// =========================================================================
// NOTIFICATIONS
// =========================================================================

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType @default(GENERIC)
  title   String
  body    String?
  data    Json?
  channel String           @default("IN_APP")
  isRead  Boolean          @default(false)
  readAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
