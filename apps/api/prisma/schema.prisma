// Atyantik EMS — Prisma schema
// Conventions (see docs/ARCHITECTURE.md for full rationale):
//  - String @id @default(cuid()) everywhere
//  - createdAt/updatedAt/deletedAt + createdBy/updatedBy (plain, unlinked String?) on every
//    domain model; soft-delete enforced app-side via a Prisma Client Extension, not here.
//  - Decimal (never Float) for all money + geo-precision fields.
//  - Only fields that are actually queried as relations (actor/assignee/approver-style)
//    get a real @relation; generic createdBy/updatedBy stay plain scalars to avoid an
//    explosion of inverse arrays on User.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

