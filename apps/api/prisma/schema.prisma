// =========================================================================
// CORE: AUTH / RBAC / AUDIT
// =========================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  isEmailVerified    Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  lastLoginAt        DateTime?
  lastLoginIp        String?

  employee      Employee?
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  notifications Notification[]

  auditLogsAsActor       AuditLog[]           @relation("AuditLogActor")
  employeeNotesAuthored  EmployeeNote[]
  leaveApprovals         LeaveApproval[]
  reviewerAssignments    ReviewerAssignment[]
  exitChecklistTasks     ExitChecklistTask[]
  exitInterviewsHeld     ExitInterview[]
  interviewPanelistOf    InterviewPanelist[]
  onboardingTasks        OnboardingTask[]
  ticketsAssigned        Ticket[]
  ticketCommentsAuthored TicketComment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  createdByUser    User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser    User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByInverse User[] @relation("UserCreatedBy")
  updatedByInverse User[] @relation("UserUpdatedBy")

  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  announcements   Announcement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  module          String
  action          String
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String?

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  family            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  sessions          Session[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Session {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenId String?
  refreshToken   RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)
  ipAddress      String?
  userAgent      String?
  deviceLabel    String?
  lastActiveAt   DateTime      @default(now())
  expiresAt      DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================================
// ORG STRUCTURE
// =========================================================================

model Company {
  id              String  @id @default(cuid())
  name            String
  legalName       String?
  cin             String?
  gstin           String?
  logoUrl         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String? @default("India")
  postalCode      String?
  timezone        String  @default("Asia/Kolkata")
  defaultCurrency String  @default("INR")

  branches         Branch[]
  departments      Department[]
  employees        Employee[]
  shifts           Shift[]
  holidays         Holiday[]
  companySettings  CompanySetting[]
  payrollRuns      PayrollRun[]
  leaveTypes       LeaveType[]
  leavePolicies    LeavePolicy[]
  salaryComponents SalaryComponent[]
  clients          Client[]
  projects         Project[]
  vendors          Vendor[]
  courses          Course[]
  jobOpenings      JobOpening[]
  announcements    Announcement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("companies")
}

model Branch {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  name         String
  code         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  timezone     String  @default("Asia/Kolkata")

  employees     Employee[]
  holidays      Holiday[]
  announcements Announcement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  name               String
  code               String
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subDepartments     Department[] @relation("DepartmentHierarchy")
  headEmployeeId     String?
  headEmployee       Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  employees     Employee[]     @relation("DepartmentEmployees")
  designations  Designation[]
  teams         Team[]
  jobOpenings   JobOpening[]
  announcements Announcement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([companyId, code])
  @@map("departments")
}

model Designation {
  id           String      @id @default(cuid())
  title        String
  level        Int?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  employees Employee[]
  offers    Offer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("designations")
}

model Team {
  id             String      @id @default(cuid())
  name           String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  leadEmployeeId String?
  leadEmployee   Employee?   @relation("TeamLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)

  members Employee[] @relation("TeamMembers")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("teams")
}

model Shift {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  name               String
  startTime          String
  endTime            String
  breakMinutes       Int       @default(0)
  weekOffDays        WeekDay[]
  gracePeriodMinutes Int       @default(0)

  employees Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("shifts")
}

model Holiday {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id])
  name       String
  date       DateTime    @db.Date
  type       HolidayType @default(NATIONAL)
  isOptional Boolean     @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([companyId, date])
  @@map("holidays")
}

model CompanySetting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([companyId, key])
  @@map("company_settings")
}

// =========================================================================
// EMPLOYEE
// =========================================================================

model Employee {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  employeeCode String @unique

  firstName      String
  middleName     String?
  lastName       String
  displayName    String?
  personalEmail  String?
  phone          String?
  alternatePhone String?
  dateOfBirth    DateTime?      @db.Date
  gender         Gender?
  maritalStatus  MaritalStatus?
  bloodGroup     BloodGroup?
  nationality    String?
  photoUrl       String?

  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  branchId           String?
  branch             Branch?      @relation(fields: [branchId], references: [id])
  departmentId       String?
  department         Department?  @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation? @relation(fields: [designationId], references: [id])
  teamId             String?
  team               Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  shiftId            String?
  shift              Shift?       @relation(fields: [shiftId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?    @relation("ManagerReports", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports      Employee[]   @relation("ManagerReports")

  employmentType   EmploymentType @default(FULL_TIME)
  status           EmployeeStatus @default(PROBATION)
  dateOfJoining    DateTime       @db.Date
  probationEndDate DateTime?      @db.Date
  confirmationDate DateTime?      @db.Date
  dateOfExit       DateTime?      @db.Date
  noticePeriodDays Int?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  panNumber         String?
  aadhaarNumber     String?
  uanNumber         String?
  pfNumber          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?

  documents           EmployeeDocument[]
  emergencyContacts   EmergencyContact[]
  educationRecords    EducationRecord[]
  experienceRecords   ExperienceRecord[]
  employeeSkills      EmployeeSkill[]
  certifications      Certification[]
  notes               EmployeeNote[]
  attendanceRecords   AttendanceRecord[]
  correctionRequests  AttendanceCorrectionRequest[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  salaryStructures    SalaryStructure[]
  salaryRevisions     SalaryRevision[]
  payslips            Payslip[]
  reimbursements      Reimbursement[]
  deductions          Deduction[]
  goals               Goal[]
  performanceReviews  PerformanceReview[]
  projectAssignments  ProjectAssignment[]
  timesheets          Timesheet[]
  assetAssignments    AssetAssignment[]
  resignations        Resignation[]
  onboardingChecklist OnboardingChecklist?
  ticketsRaised       Ticket[]
  enrollments         Enrollment[]
  expenseClaims       ExpenseClaim[]
  travelRequests      TravelRequest[]
  documentsOwned      Document[]

  headedDepartments Department[] @relation("DepartmentHead")
  ledTeams          Team[]       @relation("TeamLead")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@index([status])
  @@index([deletedAt])
  @@map("employees")
}

model EmployeeDocument {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  category     DocumentCategory @default(OTHER)
  fileUrl      String
  fileName     String
  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("employee_documents")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  name         String
  relationship String
  phone        String
  altPhone     String?
  address      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("emergency_contacts")
}

model EducationRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  degree       String
  institution  String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?
  documentUrl  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("education_records")
}

model ExperienceRecord {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  companyName String
  designation String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  description String?
  documentUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("experience_records")
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  employeeSkills EmployeeSkill[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("skills")
}

model EmployeeSkill {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  skillId           String
  skill             Skill            @relation(fields: [skillId], references: [id])
  proficiency       SkillProficiency @default(BEGINNER)
  yearsOfExperience Decimal?         @db.Decimal(4, 1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

model Certification {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  name          String
  issuingBody   String?
  issueDate     DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  credentialId  String?
  credentialUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("certifications")
}

model EmployeeNote {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  type           String   @default("NOTE")
  title          String?
  body           String
  isConfidential Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([employeeId])
  @@map("employee_notes")
}

// =========================================================================
// ATTENDANCE
// =========================================================================

model AttendanceRecord {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  date              DateTime         @db.Date
  checkInAt         DateTime?
  checkInLat        Decimal?         @db.Decimal(9, 6)
  checkInLng        Decimal?         @db.Decimal(9, 6)
  checkInIp         String?
  checkOutAt        DateTime?
  checkOutLat       Decimal?         @db.Decimal(9, 6)
  checkOutLng       Decimal?         @db.Decimal(9, 6)
  checkOutIp        String?
  totalWorkMinutes  Int?
  totalBreakMinutes Int?
  status            AttendanceStatus @default(PRESENT)
  source            AttendanceSource @default(WEB)
  isRegularized     Boolean          @default(false)
  remarks           String?

  breaks             AttendanceBreak[]
  correctionRequests AttendanceCorrectionRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([employeeId, date])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceBreak {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
