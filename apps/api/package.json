    "vitest": "^2.1.3",
    "supertest": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/multer": "^1.4.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/supertest": "^6.0.2",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.10.0"
