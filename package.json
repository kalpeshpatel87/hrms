{
  "name": "atyantik-ems",
  "version": "0.1.0",
  "private": true,
  "description": "Atyantik EMS - Enterprise Employee Management System",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter shared-types build",
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter shared-types build && pnpm --filter ./apps/* build",
    "lint": "pnpm --filter ./apps/* --filter ./packages/* lint",
    "typecheck": "pnpm --filter shared-types build && pnpm --filter ./apps/* --filter ./packages/* typecheck",
    "test": "pnpm --filter shared-types build && pnpm --filter ./apps/* test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write \"**/*.{ts,svelte,js,json,md,scss}\" --ignore-path .gitignore",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
