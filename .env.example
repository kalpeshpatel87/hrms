# Root-level env, consumed by docker-compose.yml. Each app also has its own
# .env.example (apps/api/.env.example, apps/web/.env.example) for running
# outside Docker. See docs/ENV_VARS.md for the full reference.

# --- Postgres (docker-compose) ---
POSTGRES_USER=atyantik
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=atyantik_ems
POSTGRES_PORT=5432

# --- Ports exposed by compose ---
API_PORT=4000
WEB_PORT=3000
NGINX_PORT=8080

NODE_ENV=development
